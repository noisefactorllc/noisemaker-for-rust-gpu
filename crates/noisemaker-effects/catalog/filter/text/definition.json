    "bgOpacity": "matteOpacity",
    "bgAlpha": "matteOpacity",
    "bgColor": "matteColor"
  },
  "passes": [
    {
      "name": "overlay",
      "program": "text",
      "inputs": {
        "inputTex": "inputTex",
        "textTex": "textTex"
      },
      "uniforms": {
        "matteColor": "matteColor",
        "matteOpacity": "matteOpacity"
      },
      "outputs": {
        "fragColor": "outputTex"
      }
    }
