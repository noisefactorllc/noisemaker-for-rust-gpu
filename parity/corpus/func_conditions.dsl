search synth

let pulse = () => time % 2 > 1
let broken = () => time >

noise().write(o0)

if (() => time > 1) {
  noise(seed: 2).write(o1)
} elif (() => time >) {
  noise(seed: 3).write(o2)
} elif (pulse) {
  noise(seed: 4).write(o3)
} elif (broken) {
  noise(seed: 5).write(o4)
} else {
  noise(seed: 6).write(o5)
}

return () => time +

render(o0)
