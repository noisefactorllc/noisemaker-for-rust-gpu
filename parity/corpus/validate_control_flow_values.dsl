search synth, filter

let n = noise(3)
let k = synth.noise
let s = filter.text.justify.left
let m = foo.bar
let f = () => time
let num = 4

noise().write(o0)

if (k) { noise().write(o1) } elif (s) { noise().write(o2) } elif (m) { noise().write(o3) } elif (f) { noise().write(o4) } elif (num) { noise().write(o5) }
if (n) { noise().write(o1) } elif (mouse) { noise().write(o2) } elif (synth.noise.type) { noise().write(o3) } elif (k.type.simplex) { noise().write(o4) }

return k
return s
return s.length
return n.args
return n.name.length
return k.type.simplex
return m
return f
return num
return synth.noise.octaves
return filter.text.justify
return #fff
return [1, 2]
return read(o1)
return osc(type: oscKind.saw)

render(o0)
