search synth, filter

noise(octaves: osc(type: oscKind.sine)).write(o0)
noise(octaves: osc(type: oscKind.saw, min: 0.2, max: 0.8, speed: 2, offset: 0.5, seed: 3)).write(o1)
noise(octaves: osc(type: 4)).write(o2)
noise(octaves: osc(type: 9)).write(o3)
noise(octaves: osc(type: bogus)).write(o4)
noise(octaves: osc(type: "sine")).write(o5)
noise(octaves: osc(type: tri)).write(o6)
noise(octaves: osc(min: true, max: false)).write(o7)
noise(octaves: osc(min: -1, max: 5)).write(o0)
noise(octaves: osc(speed: bogus)).write(o1)
noise(octaves: osc(speed: "x")).write(o2)
noise(octaves: osc(speed: #fff)).write(o3)
noise(octaves: osc(speed: oscKind.noise)).write(o4)
noise(octaves: osc(speed: foo.bar, offset: synth.noise, seed: 0 / 0)).write(o5)
noise(octaves: osc()).write(o6)
