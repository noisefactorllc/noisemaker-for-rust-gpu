#!/usr/bin/env node
// scripts/test — repository test entrypoint.
//
// Runs every check that needs no GPU, against the pinned reference revision
// (parity/reference.json):
//   - the catalog freshness gate (parity/check_effects.mjs): definitions, WGSL,
//     manifest, meshes, palettes, strings, the demo font and the demo's test
//     card byte-identical to the reference;
//   - the export kit's effect list freshness gate
//     (tools/generate-kit-compat.mjs --check: export-kit/compat-effects.json);
//   - the coverage corpus and timed tier freshness gate
//     (tools/generate-coverage.mjs --check: parity/coverage, parity/timed);
//   - the Rust unit and integration tests of the GPU-free crates
//     (noisemaker-effects, noisemaker-dsl);
//   - the frontend parity gate (parity/check_frontend.mjs): tokens, AST,
//     validated plans, expanded passes and the render graph of every fixture
//     (parity/programs, parity/corpus, parity/coverage, parity/timed,
//     parity/curated) equal to the reference's;
//   - the DSL tooling gate (parity/check_dsl_tools.mjs --rust-frontend):
//     unparse, formatValue, parameter updates, transforms, error formatting and
//     effect-definition validation equal to the reference's;
//   - the ProgramState gate (parity/check_program_state.mjs): the host state
//     layer's results, events, console output and pipeline effects equal to the
//     reference's over every fixture and the reference's own scenarios;
//   - the public-API gate (parity/check_api.mjs): tags and namespaces (with the
//     parser and validator against registered namespaces), the cosine
//     palettes bit for bit, block categories, the Effect constructor and
//     parameter categories, the canvas.js helpers over every catalog effect,
//     the effect/op/starter/enum registries and the resource allocator equal
//     to the reference's;
//   - the Portable gate (parity/check_portable.mjs): registerPortableEffect's
//     thrown messages and resulting registry state (effect lookups, ops, enums,
//     starter ops, aliases) equal to the reference's over its own tests, every
//     catalog effect as a Portable definition, the effect validator's
//     definitions, edge cases and the Portable parity fixtures' programs;
//   - the external-input gates: MIDI state, audio state and automation
//     evaluation (parity/check_midi_state.mjs, check_audio_state.mjs,
//     check_automation.mjs) bit-identical to the reference's.
// The pixel parity sweep needs a GPU and Chromium with WebGPU; it is
// scripts/parity-summary.
//
// Environment: NM_REFERENCE_ROOT (a reference checkout at the pin; cloned into
// $TMPDIR when unset), NM_TEST_REFERENCE (reuse a checkout that contains the pin).
// Exits nonzero on any failure.

import { spawnSync } from 'node:child_process'
import { existsSync, mkdirSync, readFileSync, readdirSync, rmSync, unlinkSync, writeFileSync } from 'node:fs'
import { homedir, tmpdir } from 'node:os'
import { join, resolve } from 'node:path'
import { fileURLToPath } from 'node:url'

const ROOT = resolve(fileURLToPath(import.meta.url), '..', '..')
const PIN = JSON.parse(readFileSync(join(ROOT, 'parity', 'reference.json'), 'utf8')).commit

function run (cmd, args, opts = {}) {
  const r = spawnSync(cmd, args, { stdio: 'inherit', cwd: ROOT, ...opts })
  if (r.status !== 0) {
    console.error(`FAIL: ${cmd} ${args.join(' ')} (exit ${r.status ?? r.signal})`)
    process.exit(1)
  }
}

// ---- reference checkout at the pin -------------------------------------------------
let referenceRoot = process.env.NM_REFERENCE_ROOT
if (!referenceRoot) {
  const named = process.env.NM_TEST_REFERENCE
  referenceRoot = named || join(tmpdir(), `noisemaker-reference-${PIN.slice(0, 12)}`)
  if (!existsSync(join(referenceRoot, 'shaders', 'src'))) {
    // Replace only the cache directory this script owns. A directory that the
    // caller named is cloned into only while it is absent or empty.
    if (named && existsSync(named) && readdirSync(named).length > 0) {
      console.error(`NM_TEST_REFERENCE ${named} is not a noisemaker checkout (no shaders/src); it was not changed`)
      process.exit(1)
    }
    if (!named) rmSync(referenceRoot, { recursive: true, force: true })
    mkdirSync(referenceRoot, { recursive: true })
    run('git', ['clone', '--quiet', 'https://github.com/noisefactorllc/noisemaker.git', referenceRoot])
  }
  const head = spawnSync('git', ['-C', referenceRoot, 'rev-parse', 'HEAD'], { encoding: 'utf8' }).stdout.trim()
  if (head !== PIN) {
    run('git', ['-C', referenceRoot, 'fetch', '--quiet', 'origin'])
    run('git', ['-C', referenceRoot, 'checkout', '--quiet', PIN])
  }
}
console.log(`reference checkout: ${referenceRoot}`)
const env = { ...process.env, NM_REFERENCE_ROOT: referenceRoot }

// ---- Rust toolchain ----------------------------------------------------------------
function findCargo () {
  const onPath = spawnSync('cargo', ['--version'], { encoding: 'utf8' })
  if (onPath.status === 0) return 'cargo'
  const home = join(process.env.CARGO_HOME || join(homedir(), '.cargo'), 'bin', 'cargo')
  if (existsSync(home)) return home
  console.log('installing the Rust toolchain with rustup (minimal profile)')
  run('sh', ['-c', "curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y --no-modify-path --profile minimal"])
  return home
}
const cargo = findCargo()

// Cargo writes its registry index, package cache and build state under
// CARGO_HOME. Check containers ship a read-only one (an immutable
// /opt/rust/cargo), which fails every crate download after the toolchain
// resolves. Probe the configured home and fall back to a writable directory;
// the rustup proxy keeps resolving toolchains through RUSTUP_HOME.
function writableCargoHome (candidate) {
  try {
    mkdirSync(candidate, { recursive: true })
    const probe = join(candidate, '.scripts-test-probe')
    writeFileSync(probe, '')
    unlinkSync(probe)
    return true
  } catch {
    return false
  }
}
const configuredCargoHome = process.env.CARGO_HOME || join(homedir(), '.cargo')
if (!writableCargoHome(configuredCargoHome)) {
  const fallback = join(tmpdir(), 'nm-cargo-home')
  if (!writableCargoHome(fallback)) {
    console.error(`no writable cargo home (tried ${configuredCargoHome}, ${fallback})`)
    process.exit(1)
  }
  console.log(`cargo home ${configuredCargoHome} is not writable; using ${fallback}`)
  env.CARGO_HOME = fallback
}

// ---- focused mode (NM_CHANGED_FILES) ------------------------------------------------
// The supervisor passes this candidate's changed paths, one per line. Run only
// the tests that exercise those paths so a focused run stays inside its time
// budget; with the variable unset the full suite below runs exactly as before.
const changedFiles = (process.env.NM_CHANGED_FILES || '')
  .split('\n').map(s => s.trim().replace(ROOT + '/', '')).filter(Boolean)
if (changedFiles.length > 0) {
  const catalogTouched = changedFiles.some(p =>
    p.startsWith('crates/noisemaker-effects/catalog/') || p === 'parity/reference.json')
  const crates = new Set()
  for (const p of changedFiles) {
    const m = p.match(/^crates\/([^/]+)\//)
    if (m) crates.add(m[1])
  }
  if (catalogTouched) {
    // The catalog freshness gate and the export-kit list are the direct tests
    // of the catalog data and the parity pin.
    run('node', ['parity/check_effects.mjs'], { env })
    run('node', ['tools/generate-kit-compat.mjs', '--check'], { env })
    crates.add('noisemaker-effects')
    crates.add('noisemaker-dsl')
  }
  const tested = ['noisemaker-effects', 'noisemaker-dsl', 'noisemaker-input',
    'noisemaker-host'].filter(name => crates.has(name))
  if (tested.length) {
    run(cargo, ['test', '--release', ...tested.flatMap(name => ['-p', name])], { env })
  }
  // The deeper parity gates need the release binaries. Build them only when a
  // previous run left them in place, so a cold focused run stays bounded;
  // exact-source CI still runs the full suite.
  const hasBin = name => existsSync(join(ROOT, 'target', 'release', name))
  if (catalogTouched) {
    if (hasBin('nm-render')) {
      // Fixture programs that exercise the changed effects' contracts.
      const effects = new Set()
      for (const p of changedFiles) {
        const m = p.match(/^crates\/noisemaker-effects\/catalog\/(?:[^/]+\/)*([^/]+)\/(?:definition\.json|wgsl\/)/)
        if (m) effects.add(m[1])
      }
      const programs = ['programs', 'corpus', 'coverage', 'timed', 'curated'].flatMap(dir =>
        readdirSync(join(ROOT, 'parity', dir)).filter(f => f.endsWith('.dsl')).sort()
          .filter(f => {
            const text = readFileSync(join(ROOT, 'parity', dir, f), 'utf8')
            return [...effects].some(e => text.includes(e))
          }).map(f => join(ROOT, 'parity', dir, f)))
      if (programs.length) {
        run('node', ['parity/check_frontend.mjs', '--programs', ...programs], {
          env: { ...env, NM_RENDER: join(ROOT, 'target', 'release', 'nm-render') }
        })
      }
    }
    if (hasBin('nm-dsl')) {
      run('node', ['parity/check_dsl_tools.mjs', '--rust-frontend'], {
        env: { ...env, NM_DSL: join(ROOT, 'target', 'release', 'nm-dsl') }
      })
    }
    if (hasBin('nm-api')) {
      run('node', ['parity/check_api.mjs'], { env: { ...env, NM_API: join(ROOT, 'target', 'release', 'nm-api') } })
      run('node', ['parity/check_portable.mjs'], { env: { ...env, NM_API: join(ROOT, 'target', 'release', 'nm-api') } })
    }
  }
  console.log('scripts/test: focused checks passed')
  process.exit(0)
}

// ---- gates ---------------------------------------------------------------------------
run('node', ['parity/check_effects.mjs'], { env })
run('node', ['tools/generate-kit-compat.mjs', '--check'], { env })
run('node', ['tools/generate-coverage.mjs', '--check'], { env })
// The noisemaker-tint test compares the linked Tint with Chromium's MSL; Tint
// is built on Apple targets only.
const testedCrates = ['noisemaker-effects', 'noisemaker-dsl', 'noisemaker-input',
  ...(process.platform === 'darwin' ? ['noisemaker-tint'] : [])]
run(cargo, ['test', '--release', ...testedCrates.flatMap(name => ['-p', name])], { env })
// noisemaker-host's OBJ and worm differentials compare with NM_REFERENCE_ROOT and
// print their summaries, or why they skipped, on stderr.
run(cargo, ['test', '--release', '-p', 'noisemaker-host', '--', '--nocapture'], { env })
run(cargo, ['build', '--release', '-p', 'nm-render', '-p', 'noisemaker-dsl', '-p', 'noisemaker-input', '--bins'], { env })
const programs = ['programs', 'corpus', 'coverage', 'timed', 'curated'].flatMap(dir =>
  readdirSync(join(ROOT, 'parity', dir)).filter(f => f.endsWith('.dsl')).sort().map(f => join(ROOT, 'parity', dir, f)))
run('node', ['parity/check_frontend.mjs', '--programs', ...programs], {
  env: { ...env, NM_RENDER: join(ROOT, 'target', 'release', 'nm-render') }
})
run('node', ['parity/check_dsl_tools.mjs', '--rust-frontend'], {
  env: { ...env, NM_DSL: join(ROOT, 'target', 'release', 'nm-dsl') }
})
run('node', ['parity/check_program_state.mjs'], {
  env: { ...env, NM_PROGRAM_STATE: join(ROOT, 'target', 'release', 'nm-program-state') }
})
for (const gate of ['check_api', 'check_portable']) {
  run('node', [`parity/${gate}.mjs`], {
    env: { ...env, NM_API: join(ROOT, 'target', 'release', 'nm-api') }
  })
}
for (const gate of ['check_midi_state', 'check_audio_state', 'check_automation']) {
  run('node', [`parity/${gate}.mjs`], {
    env: { ...env, NM_INPUT_DUMP: join(ROOT, 'target', 'release', 'nm-input-dump') }
  })
}
console.log('scripts/test: all checks passed')
